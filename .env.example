# Copy to .env and fill locally. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Alternatively, use an OpenAI-compatible gateway:
# ALICE_OPENAI_KEY=
# ALICE_CHAT_URL=https://your-gateway.example/v1
# ALICE_EMBED_URL=https://your-gateway.example/v1
# ALICE_CHAT_MODEL=openai/gpt-4o-mini
